# Copie este arquivo para .env-dev (não commitar).
# Neon Console → Project → Connect → connection string (URI).
DATABASE_URL=postgresql://USER:SENHA@HOST/neondb?sslmode=require

# Neon Auth (página Auth do projeto). Não é segredo; usado no build do frontend.
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.sa-east-1.aws.neon.tech/neondb/auth

# Neon Data API (PostgREST). Não é segredo; RLS protege as linhas por usuário.
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.sa-east-1.aws.neon.tech/neondb/rest/v1
